marks(rahul,[90,90,80,90]).
marks(gokul,[10,20,30,40]).

sum_marks([],0).
sum_marks([H|T],Sum):-
	sum_marks(T,Rest),
	Sum is H+Rest.

count_marks([],0).
count_marks([H|T],Count):-
	count_marks(T,Rest),
	Count is Rest+1.


max_marks([H],H).
max_marks([H|T],M):-
	max_marks(T,Rest),
	M is max(H,Rest).


min_marks([H],H).
min_marks([H|T],Minn):-
	min_marks(T,Rest),
	Minn is min(H,Rest).

avg(Marks,A):-
	sum_marks(Marks,Sum),
	count_marks(Marks,Count),
	A is Sum/Count.


show([H|T]):-
	format('First element:~w ~n',[H]),
	format('Remaining element:~w ~n',[T]).

student_report(Student):-
	marks(Student,Marks),format('Student name:~w ~n',[Student]),
	sum_marks(Marks,Sum),
	count_marks(Marks,Count),
	avg(Marks,Avg),
	max_marks(Marks,Max),
	min_marks(Marks,Min),
	show(Marks),
	format('Sum:~w ~n',[Sum]),
	format('Count:~w ~n',[Count]),
	format('Max:~w ~n',[Max]),
	format('Min:~w ~n',[Min]),
	format('Avg:~w ~n',[Avg]).
student_report(Student):-
	\+ marks(Student,_),
	format('Student "~w" does not exist',[Student]).
