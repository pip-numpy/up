data = LOAD 'supermarket_sales.csv'
       USING PigStorage(',')
       AS (
           Invoice_ID:chararray,
           Branch:chararray,
           City:chararray,
           Customer_type:chararray,
           Gender:chararray,
           Product_line:chararray,
           Unit_price:double,
           Quantity:int,
           Tax:double,
           Total:double,
           Sale_date:chararray,
           Sale_time:chararray,
           Payment:chararray,
           COGS:double,
           Gross_margin_pct:double,
           Gross_income:double,
           Rating:double
       );
       
clean_data = FILTER data BY City != 'City';
first55 = LIMIT clean_data 55;
DESCRIBE clean_data;
DUMP first55;


trans_fil = FILTER clean_data BY Total > 500;
DUMP trans_fil;

pro1 = FOREACH clean_data GENERATE Invoice_ID, City, Product_line, Quantity,Total;
DUMP pro1;

ordered_rec = ORDER clean_data BY Total DESC;
top10 = LIMIT ordered_rec 10;
pro2 = FOREACH top10 GENERATE Invoice_ID,Product_line,Total;
DUMP pro2;

all_productline = FOREACH clean_data GENERATE Product_line;
rem_all_productline = DISTINCT all_productline;
DUMP rem_all_productline;

group1 = GROUP clean_data BY Payment;
DESCRIBE group1;
trans_list = FOREACH group1 GENERATE group,COUNT(clean_data.Payment) AS trans_count;
DUMP trans_list;


group1 = GROUP clean_data BY Payment;
avg_total = FOREACH group1 GENERATE group,AVG(clean_data.Total) AS trans_avg;
DUMP avg_total;

group2 = GROUP clean_data BY Product_line;
DESCRIBE group2;
total_sales = FOREACH group2 GENERATE group,SUM(clean_data.Total) AS total;
DUMP total_sales;

one_group = GROUP clean_data ALL;
maxi = FOREACH one_group GENERATE MAX(clean_data.Total) AS maximum_total;
mini = FOREACH one_group GENERATE MIN(clean_data.Total) AS minimum_total;

DUMP maxi;
DUMP mini;

fil1 = FILTER clean_data BY Quantity >= 5 AND Total > 500;
out = FOREACH fil1 GENERATE Invoice_ID, Product_line, Quantity,Total;
DUMP out;

SPLIT clean_data INTO
	high_value IF Total>=500,
	low_value IF Total < 500,
	unknown OTHERWISE;

first5 = LIMIT high_value 5;
DUMP first5;

first5 = LIMIT low_value 5;
DUMP first5;

combined = UNION low_value,high_value;
first5 = LIMIT combined 5;
DUMP first5;

JOIN high_value BY Invoice_ID, low_value BY Invoice_ID;
first5 = LIMIT combined 5;
DUMP first5;


branch_info = FOREACH clean_data GENERATE Branch,City;
DESCRIBE branch_info;
branch_info = DISTINCT branch_info;

join1 = JOIN clean_data by Branch, branch_info by Branch;
out = FOREACH join1 GENERATE Invoice_ID, Branch, City, Total;
first5 = LIMIT out 5;
DUMP first5;

branch_info = FOREACH clean_data GENERATE Branch, City;
branch_info = DISTINCT branch_info;

join1 = JOIN clean_data BY Branch,
             branch_info BY Branch;

out = FOREACH join1 GENERATE
      clean_data::Invoice_ID,
      clean_data::Branch,
      branch_info::City,
      clean_data::Total;

first5 = LIMIT out 5;
DUMP first5;

/* javac -cp "$PIG_HOME/pig-0.18.0-core-h3.jar:$(hadoop classpath)" SalesCategory.java

jar cf SalesCategory.jar SalesCategory.class  

*/

REGISTER 'myudf.jar';
out = FOREACH clean_data GENERATE Branch,Total,SalesCategory(Total) AS sales_category;
out = LIMIT out 5;
DUMP out;

REGISTER 'sales.jar';
DEFINE HighSalesFilter HighSalesFilter();
data = LOAD 'sales.csv'
USING PigStorage(',')
AS (Invoice_ID:chararray, Total:double);
high_sales = FILTER data BY HighSalesFilter(Total);
DUMP high_sales;


-------------------
import java.io.IOException;
import org.apache.pig.EvalFunc;
import org.apache.pig.data.Tuple;

public class SalesCategory extends EvalFunc<String>{

@Override
public String exec(Tuple input) throws IOException{

if (input == null || input.size() == 0 || input.get(0) == null) return null;
double value = Double.parseDouble(input.get(0).toString());

if(value >=500) return "High";
if(value >=250) return "Medium";
else return "low";
}}


import java.io.IOException;
import org.apache.pig.FilterFunc;
import org.apache.pig.data.Tuple;

public class HighSalesFilter extends FilterFunc {

    @Override
    public Boolean exec(Tuple input) throws IOException {

        if (input == null || input.size() == 0
                || input.get(0) == null) {
            return false;
        }

        double value =
            Double.parseDouble(input.get(0).toString());

        return value >= 500;
    }
}


