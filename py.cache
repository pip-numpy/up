import java.io.IOException;

import org.apache.hadoop.conf.Configuration;
import org.apache.hadoop.fs.Path;

import org.apache.hadoop.io.IntWritable;
import org.apache.hadoop.io.Text;

import org.apache.hadoop.mapreduce.Job;
import org.apache.hadoop.mapreduce.Mapper;
import org.apache.hadoop.mapreduce.Reducer;

import org.apache.hadoop.mapreduce.lib.input.FileInputFormat;
import org.apache.hadoop.mapreduce.lib.output.FileOutputFormat;

public class UniversalCount {

    // =========================
    // MAPPER
    // =========================
    public static class CountMapper
            extends Mapper<Object, Text, Text, IntWritable> {

        private final static IntWritable ONE = new IntWritable(1);
        private Text outputKey = new Text();

        private int columnIndex;
        private String separator;
        private boolean skipHeader;

        @Override
        protected void setup(Context context) {

            Configuration conf = context.getConfiguration();

            columnIndex =
                    Integer.parseInt(conf.get("column.index"));

            separator =
                    conf.get("separator", ",");

            skipHeader =
                    conf.getBoolean("skip.header", true);
        }

        @Override
        public void map(
                Object key,
                Text value,
                Context context)
                throws IOException, InterruptedException {

            String line = value.toString().trim();

            // Ignore empty lines
            if (line.isEmpty())
                return;

            // Skip first/header-type line
            if (skipHeader && line.toLowerCase().contains("id,"))
                return;

            // Split record
            String[] fields =
                    line.split(separator, -1);

            // Check column
            if (fields.length <= columnIndex)
                return;

            String selectedValue =
                    fields[columnIndex].trim();

            // Ignore empty values
            if (selectedValue.isEmpty())
                return;

            outputKey.set(selectedValue);

            // key -> 1
            context.write(outputKey, ONE);
        }
    }


    // =========================
    // REDUCER
    // =========================
    public static class CountReducer
            extends Reducer<Text, IntWritable, Text, IntWritable> {

        @Override
        public void reduce(
                Text key,
                Iterable<IntWritable> values,
                Context context)
                throws IOException, InterruptedException {

            int sum = 0;

            for (IntWritable value : values) {
                sum += value.get();
            }

            context.write(
                    key,
                    new IntWritable(sum)
            );
        }
    }


    // =========================
    // DRIVER
    // =========================
    public static void main(String[] args)
            throws Exception {

        /*
         * args[0] = input path
         * args[1] = output path
         * args[2] = column index
         */

        Configuration conf = new Configuration();

        // Command-line parameter
        conf.set(
                "column.index",
                args[2]
        );

        conf.set(
                "separator",
                ","
        );

        conf.setBoolean(
                "skip.header",
                true
        );


        Job job =
                Job.getInstance(
                        conf,
                        "Universal Count"
                );

        job.setJarByClass(
                UniversalCount.class
        );

        job.setMapperClass(
                CountMapper.class
        );

        job.setReducerClass(
                CountReducer.class
        );

        job.setOutputKeyClass(
                Text.class
        );

        job.setOutputValueClass(
                IntWritable.class
        );


        FileInputFormat.addInputPath(
                job,
                new Path(args[0])
        );

        FileOutputFormat.setOutputPath(
                job,
                new Path(args[1])
        );


        System.exit(
                job.waitForCompletion(true)
                        ? 0
                        : 1
        );
    }
}
*-*-*-*-*-*-*-
import java.io.IOException;

import org.apache.hadoop.conf.Configuration;
import org.apache.hadoop.fs.Path;
import org.apache.hadoop.io.IntWritable;
import org.apache.hadoop.io.LongWritable;
import org.apache.hadoop.io.Text;
import org.apache.hadoop.mapreduce.Job;
import org.apache.hadoop.mapreduce.Mapper;
import org.apache.hadoop.mapreduce.Reducer;
import org.apache.hadoop.mapreduce.lib.input.FileInputFormat;
import org.apache.hadoop.mapreduce.lib.output.FileOutputFormat;

public class CountUser {

    // Mapper
    public static class CountUserMapper
            extends Mapper<LongWritable, Text, Text, IntWritable> {

        public void map(LongWritable key, Text value, Context context)
                throws IOException, InterruptedException {

            String[] fields = value.toString().split(",");

            context.write(new Text(fields[3]), new IntWritable(1));
        }
    }

    // Reducer
    public static class CountUserReducer
            extends Reducer<Text, IntWritable, Text, IntWritable> {

        public void reduce(Text key, Iterable<IntWritable> values,
                           Context context)
                throws IOException, InterruptedException {

            int sum = 0;

            for (IntWritable value : values) {
                sum += value.get();
            }

            context.write(key, new IntWritable(sum));
        }
    }

    // Driver
    public static void main(String[] args) throws Exception {

        Configuration conf = new Configuration();

        Job job = Job.getInstance(conf, "Count User");

        job.setJarByClass(CountUser.class);

        job.setMapperClass(CountUserMapper.class);
        job.setReducerClass(CountUserReducer.class);

        job.setOutputKeyClass(Text.class);
        job.setOutputValueClass(IntWritable.class);

        FileInputFormat.addInputPath(job, new Path(args[0]));

        FileOutputFormat.setOutputPath(job, new Path(args[1]));

        System.exit(job.waitForCompletion(true) ? 0 : 1);
    }
}



