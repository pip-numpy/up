NIST DSA:

from hashlib import sha256
from secrets import randbelow

p, q, g = 809, 101, 256

def H(m):
    return int.from_bytes(sha256(m.encode()).digest(), "big") % q

def sign(m, x):
    h = H(m)
    while 1:
        k = randbelow(q-1) + 1
        r = pow(g, k, p) % q
        if r:
            s = pow(k, -1, q) * (h + x*r) % q
            if s:
                return r, s

def verify(m, r, s, y):
    h = H(m)
    w = pow(s, -1, q)
    u1 = h*w % q
    u2 = r*w % q
    v = (pow(g,u1,p) * pow(y,u2,p) % p) % q
    return v == r

m = input("Enter document: ")

x = randbelow(q-1) + 1
y = pow(g, x, p)

r, s = sign(m, x)

print("\nPrivate Key:", x)
print("Public Key:", y)
print("Hash:", H(m))
print("Signature:", r, s)

print("Verification:", "VALID" if verify(m,r,s,y) else "INVALID")

m2 = input("\nModified document: ")
print("Modified Verification:",
      "VALID" if verify(m2,r,s,y) else "INVALID")
—----------------------------------------------------------------------------------------------------

ECDSA:

import hashlib

p, a, b = 17, 2, 2
G, n, d = (5,1), 19, 7

def add(P,Q):
    if P is None: return Q
    if Q is None: return P

    x1,y1 = P
    x2,y2 = Q

    if x1 == x2 and (y1+y2) % p == 0:
        return None

    if P == Q:
        m = (3*x1*x1+a) * pow(2*y1,-1,p) % p
    else:
        m = (y2-y1) * pow(x2-x1,-1,p) % p

    x3 = (m*m-x1-x2) % p
    y3 = (m*(x1-x3)-y1) % p

    return x3,y3

def mul(k,P):
    R = None
    for _ in range(k):
        R = add(R,P)
    return R

def H(m):
    h = hashlib.sha256(m.encode()).hexdigest()
    return int(h,16) % n

Q = mul(d,G)

m = input("Enter message: ")

z = H(m)
k = 5
R = mul(k,G)
r = R[0] % n
s = pow(k,-1,n) * (z+r*d) % n

print("\nPrivate Key:", d)
print("Public Key:", Q)
print("SHA-256:", hashlib.sha256(m.encode()).hexdigest())
print("Hash z:", z)
print("k:", k)
print("R:", R)
print("Signature:", r,s)

def verify(m,r,s):
    z = H(m)
    si = pow(s,-1,n)
    u1 = z*si % n
    u2 = r*si % n
    X = add(mul(u1,G),mul(u2,Q))

    return X is not None and X[0] % n == r

print("Verification:", "VALID" if verify(m,r,s) else "INVALID")

m2 = input("\nEnter message again: ")
print("Modified Verification:",
      "VALID" if verify(m2,r,s) else "INVALID")
