RSA:
import math

p = int(input("Enter p: "))
q = int(input("Enter q: "))

n = p * q
phi = (p - 1) * (q - 1)

e = 2
while e < phi:
    if math.gcd(e, phi) == 1:
        break
    e += 1

d = pow(e, -1, phi)

print("n =", n)
print("phi =", phi)
print("Public Key  =", (e, n))
print("Private Key =", (d, n))

m = int(input("Enter message as integer: "))

c = pow(m, e, n)
print("Encrypted =", c)

decrypted = pow(c, d, n)
print("Decrypted =", decrypted)

p = 61
q = 53

n = p * q
phi = (p - 1) * (q - 1)

e = 17
d = pow(e, -1, phi)

text = input("Enter text: ")

encrypted = [pow(ord(ch), e, n) for ch in text]
print("Encrypted:", encrypted)

decrypted = "".join(chr(pow(x, d, n)) for x in encrypted)
print("Decrypted:", decrypted)



Diffie-Hellman

q = int(input("Enter prime q: "))
a = int(input("Enter primitive root alpha: "))

xa = int(input("Enter A private key: "))
xb = int(input("Enter B private key: "))

ya = pow(a, xa, q)
yb = pow(a, xb, q)

print("A Public Key =", ya)
print("B Public Key =", yb)

ka = pow(yb, xa, q)
kb = pow(ya, xb, q)

print("A Shared Key =", ka)
print("B Shared Key =", kb)

if ka == kb:
    print("Shared secret established successfully")
else:
    print("Key exchange failed")

Caesar Cipher
def caesar(text, key):
    result = ""
    for ch in text:
        if ch.isupper():
            result += chr((ord(ch) - ord('A') + key) % 26 + ord('A'))
        elif ch.islower():
            result += chr((ord(ch) - ord('a') + key) % 26 + ord('a'))
        else:
            result += ch
    return result

choice = input("1. Encrypt\n2. Decrypt\nChoice: ")
text = input("Enter text: ")
key = int(input("Enter key: "))
if choice == "2":
    key = -key
print("Result:", caesar(text, key))

Columnar:
def columnar_encrypt(text, key):
    cols = len(key)

    while len(text) % cols != 0:
        text += 'X'

    grid = []
    for i in range(0, len(text), cols):
        grid.append(text[i:i+cols])

    order = sorted(range(cols), key=lambda i: key[i])

    cipher = ""

    for col in order:
        for row in grid:
            cipher += row[col]

    return cipher

def columnar_decrypt(cipher, key):
    cols = len(key)
    rows = len(cipher) // cols

    order = sorted(range(cols), key=lambda i: key[i])

    grid = [[''] * cols for _ in range(rows)]

    k = 0

    for col in order:
        for row in range(rows):
            grid[row][col] = cipher[k]
            k += 1

    text = ""

    for row in grid:
        text += ''.join(row)

    return text.rstrip('X')


text = input("Enter text: ").replace(" ", "")
key = input("Enter key: ")

encrypted = columnar_encrypt(text, key)
print("Encrypted:", encrypted)

decrypted = columnar_decrypt(encrypted, key)
print("Decrypted:", decrypted)
double Columnar:
def columnar_encrypt(text, key):
    cols = len(key)

    while len(text) % cols != 0:
        text += 'X'

    grid = []

    for i in range(0, len(text), cols):
        grid.append(text[i:i+cols])

    order = sorted(range(cols), key=lambda i: key[i])

    result = ""

    for col in order:
        for row in grid:
            result += row[col]

    return result


def columnar_decrypt(cipher, key):
    cols = len(key)
    rows = len(cipher) // cols

    order = sorted(range(cols), key=lambda i: key[i])

    grid = [[''] * cols for _ in range(rows)]

    k = 0

    for col in order:
        for row in range(rows):
            grid[row][col] = cipher[k]
            k += 1

    result = ""

    for row in grid:
        result += ''.join(row)

    return result


text = input("Enter text: ").replace(" ", "")
key1 = input("Enter key 1: ")
key2 = input("Enter key 2: ")

# Encryption
step1 = columnar_encrypt(text, key1)
encrypted = columnar_encrypt(step1, key2)

print("After first:", step1)
print("Encrypted:", encrypted)

# Decryption
step1 = columnar_decrypt(encrypted, key2)
decrypted = columnar_decrypt(step1, key1)

print("Decrypted:", decrypted.rstrip('X'))

Hill cipher:
import numpy as np
key = np.array([
    [6, 24, 1],
    [13, 16, 10],
    [20, 17, 15]
])
def mod_inverse(a, m):
    for x in range(1, m):
        if (a * x) % m == 1:
            return x
    return None
def inverse_matrix(key):
    det = int(round(np.linalg.det(key))) % 26
    det_inv = mod_inverse(det, 26)

    if det_inv is None:
        return None

    adj = np.round(det * np.linalg.inv(key)).astype(int) % 26

    return (det_inv * adj) % 26


def process(text, matrix):
    result = ""

    for i in range(0, len(text), 3):

        block = [
            ord(text[i]) - 65,
            ord(text[i + 1]) - 65,
            ord(text[i + 2]) - 65
        ]

        for r in range(3):
            value = 0

            for c in range(3):
                value += matrix[r][c] * block[c]

            result += chr((value % 26) + 65)

    return result


choice = input("1. Encrypt\n2. Decrypt\nChoice: ")

text = input("Enter text: ").upper().replace(" ", "")

while len(text) % 3 != 0:
    text += "X"

if choice == "1":

    cipher = process(text, key)
    print("Cipher Text:", cipher)

elif choice == "2":

    inv_key = inverse_matrix(key)

    if inv_key is None:
        print("Key cannot be inverted")
    else:
        plain = process(text, inv_key)
        print("Plain Text:", plain.rstrip("X"))

else:
    print("Invalid choice")

Playfair cipher:
key = input("Enter key: ").upper().replace("J", "I")
text = input("Enter text: ").upper().replace("J", "I").replace(" ", "")

alphabet = "ABCDEFGHIKLMNOPQRSTUVWXYZ"

# Create 5x5 matrix
matrix = []

for ch in key + alphabet:
    if ch not in matrix:
        matrix.append(ch)

table = [matrix[i:i+5] for i in range(0, 25, 5)]

print("Playfair Matrix:")
for row in table:
    print(row)


def find(ch):
    for r in range(5):
        for c in range(5):
            if table[r][c] == ch:
                return r, c


# Create pairs
pairs = []
i = 0

while i < len(text):
    a = text[i]

    if i + 1 < len(text):
        b = text[i + 1]

        if a == b:
            pairs.append(a + "X")
            i += 1
        else:
            pairs.append(a + b)
            i += 2
    else:
        pairs.append(a + "X")
        i += 1


print("Pairs:", pairs)


choice = input("1. Encrypt\n2. Decrypt\nChoice: ")

shift = 1 if choice == "1" else -1

result = ""

for pair in pairs:

    a, b = pair

    r1, c1 = find(a)
    r2, c2 = find(b)

    # Same row
    if r1 == r2:
        result += table[r1][(c1 + shift) % 5]
        result += table[r2][(c2 + shift) % 5]

    # Same column
    elif c1 == c2:
        result += table[(r1 + shift) % 5][c1]
        result += table[(r2 + shift) % 5][c2]

    # Rectangle
    else:
        result += table[r1][c2]
        result += table[r2][c1]


if choice == "1":
    print("Cipher:", result)
else:
    print("Plain:", result)

