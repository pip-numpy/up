"""
import numpy as np
from sklearn.feature_extraction.text import TfidfVectorizer
from sklearn.metrics.pairwise import cosine_similarity

dataset=[
    {"q":"What are the visiting hours of Ooty Botanical Garden?","a":"Open daily from 7:00 AM to 6:30 PM."},
    {"q":"How can I reach Ooty from Coimbatore?","a":"Regular buses and trains are available."},
    {"q":"Which is the best season to visit Kodaikanal?","a":"October to March is the ideal season."},
    {"q":"Where can I book hill station hotels?","a":"Hotels can be booked through the Tourism Portal."},
    {"q":"What is the entry fee for the Tea Museum?","a":"Adults: ₹30, Children: ₹15."}  
]

qns=[items["q"] for items in dataset]
vectorizer=TfidfVectorizer(stop_words='english')
tf_idf=vectorizer.fit_transform(qns)

def chat_response(user,th=0.3):
    user_vector=vectorizer.transform([user])
    sim=cosine_similarity(user_vector,tf_idf).flatten()
    best_match_idx=np.argmax(sim)
    best_score=sim[best_match_idx]

    if best_score < 0.3:
        print("score : ",best_score)
        print("sorry! no match found")
    else:
        print("\nscore : ",best_score)
        print("similar questions : ",qns[best_match_idx])
        print("answer : ",dataset[best_match_idx]["a"])


while True:
    user=input("\nenter query : ")
    if user.lower() == "exit":
        break
    chat_response(user)
