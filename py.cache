def xor_bits(a, b):
    return ''.join(str(int(x) ^ int(y)) for x, y in zip(a, b))

data = "1010"
key = "1100"
encrypted = xor_bits(data, key)
decrypted = xor_bits(encrypted, key)
print("Encrypted:", encrypted)
print("Decrypted:", decrypted)

FUNCTION:

def to_binary(ch):
    return format(ord(ch), '08b')
def xor_bits(a, b):
    return ''.join(str(int(x) ^ int(y)) for x, y in zip(a, b))
def swap_halves(bits):
    mid = len(bits) // 2
    return bits[mid:] + bits[:mid]
def binary_to_char(bits):
    return chr(int(bits, 2))
ch = input("Enter character: ")
key = input("Enter 8-bit key: ")
bits = to_binary(ch)
print("ASCII :", ord(ch))
print("Binary:", bits)
xored = xor_bits(bits, key)
print("XOR   :", xored)
swapped = swap_halves(xored)
print("Swap  :", swapped)
result = binary_to_char(swapped)
print("Character:", result)

