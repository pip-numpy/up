from sklearn.feature_extraction.text import TfidfVectorizer
from sklearn.metrics.pairwise import cosine_similarity

resumes = [
    {
        "id": 101,
        "name": "Arun Kumar",
        "skills": "Python, Machine Learning, SQL",
        "experience": 3,
        "profile": "Python developer experienced in machine learning, data analysis and SQL database management."
    },
    {
        "id": 102,
        "name": "Priya Sharma",
        "skills": "Java, Spring Boot, MySQL",
        "experience": 4,
        "profile": "Software engineer skilled in Java development, Spring Boot, backend systems and database design."
    },
    {
        "id": 103,
        "name": "Karthik Raj",
        "skills": "Python, NLP, Deep Learning",
        "experience": 2,
        "profile": "AI engineer working on natural language processing, deep learning and intelligent text retrieval systems."
    }
]

documents = [resume["profile"] for resume in resumes]

vectorizer = TfidfVectorizer(stop_words="english")

tfidf_matrix = vectorizer.fit_transform(documents)

query = input("Enter recruitment query: ")

query_vector = vectorizer.transform([query])

similarity_scores = cosine_similarity(query_vector, tfidf_matrix)[0]

ranked_indices = similarity_scores.argsort()[::-1]

print("\nTop Matching Candidates:")

for index in ranked_indices[:5]:
    print("Name:", resumes[index]["name"])
    print("Skills:", resumes[index]["skills"])
    print("Experience:", resumes[index]["experience"], "years")
    print("Similarity Score:", round(similarity_scores[index], 4))
    print("-" * 40)


"""
from sklearn.feature_extraction.text import TfidfVectorizer
from sklearn.metrics.pairwise import cosine_similarity

dataset=[
    {"id":"S101","name":"Harisree","Skills":"python,java,sql","years":"5"},
    {"id":"S102","name":"Aishu","Skills":"c++,java,machine learning","years":"2"},
    {"id":"S103","name":"Abi","Skills":"python,raect,deep learning","years":"1"},
    {"id":"S104","name":"Mithu","Skills":"python,c++,NLP","years":"3"},
    {"id":"S105","name":"Sachin","Skills":"c++,java,sql","years":"1"}
]

doc=[items['Skills'] + " " + items['years'] for items in dataset]
vectorizer=TfidfVectorizer(stop_words='english')
tf_idf=vectorizer.fit_transform(doc)

his=[]
def search():
      user=input("enter user query : ")
      his.append(user)
      user_vector=vectorizer.transform([user])
      sim=cosine_similarity(user_vector,tf_idf)[0]

      res=[]
      for i,score in enumerate(sim):
            res.append((dataset[i],score))

      res.sort(key=lambda x:x[1],reverse=True)

      print("\n Top 2 relevant student")
      for rank,(stu,score) in enumerate(res[:2],1):
            if score <= 0.0:
                  print("\nno student found")
                  break
            print(f"\n{rank} . ({stu['id']} - {stu['name']})")
            print(f"skills : {stu['Skills']}")
            print(f"experience : {stu['years']}")
            print(f"similarity score : {score : .2f}")
    
def view_history():
     print("\nHISTORY")
     for i ,content in enumerate(his,1):
          print(f"{i} . {content}")

def view_student():
     print("\nFilter by student sid")
     sid=input("enter student id : ").upper()
     found=False
     for d in dataset:
          if d["id"] == sid:
               found=True
               print(f"\n {d['id']} - {d['name']}")
               print(f"skills : {d['Skills']}")
               print(f"experience : {d['years']}")
     if not found:
          print(f"\nThe student with {sid} not found.")

def filter_year():
     print("\nFilter by student years of experience")
     syr=input("enter student year of experinece : ")
     found=False
     for d in dataset:
          if d["years"] == syr:
               found=True
               print(f"\n{d['id']} - {d['name']}")
               print(f"skills : {d['Skills']}")
               print(f"experience : {d['years']}")
     if not found:
          print(f"\nThe student with {syr} not found.")

def filter_skills():
     print("\nFilter by student skills")
     sskill=input("enter student skills : ").lower()
     found=False
     for d in dataset:
          skk=d["Skills"].lower()
          if sskill in skk:
               found=True
               print(f"\n {d['id']} - {d['name']}")
               print(f"skills : {d['Skills']}")
               print(f"experience : {d['years']}")
     if not found:
          print(f"\nThe student with {sskill} not found.")
     


while True:
    print("\nResume retrival")
    print("1.semantic search")
    print("2.filter by skills")
    print("3.filter by years of experience")
    print("4.display particular student details")
    print("5.view search history")
    print("6.exit")
    choice=input("enter choice : ")

    if choice == "1":
        search()
    elif choice == "2":
        filter_skills()
    elif choice == "3":
        filter_year()
    elif choice == "4":
        view_student()
    elif choice == "5":
        view_history()
    else:
          print("thankyou!!")
          exit()
