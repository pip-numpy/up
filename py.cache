XOR of Two Parts
a = input("Enter first binary: ")
b = input("Enter second binary: ")
result = ""
for x, y in zip(a, b):
    result += str(int(x) ^ int(y))
print("XOR:", result)

def xor_bits(a, b):
    return ''.join(str(int(x) ^ int(y)) for x, y in zip(a, b))
print(xor_bits("1010", "1100"))

